# Host development with the microservice catalog. Compose overrides this with
# http://host.docker.internal:8082. Legacy monolith: http://localhost:8080/api/v1.
AI_BACKEND_API_URL=http://localhost:8082
AI_REQUEST_TIMEOUT_SECONDS=5
AI_CONVERSATION_MAX_MESSAGES=20
# P2 application migrations / native saver bootstrap (host development).
AI_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/ai_db
# Integration tests also read .env. Explicit test DSN; never point at production.
AI_TEST_POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:5433/ai_db
# Opt-in P2 create/get endpoints; requires applied Alembic + saver bootstrap.
# Legacy chat remains unchanged until P5. Do not enable before dependencies sync.
AI_STATEFUL_ENABLED=false
# Optional guided-build executor (not general ReAct/SSE). Requires stateful mode,
# explicit OpenAI/Gemini provider/key and exact internal catalog UUID mapping.
AI_STATEFUL_BUILD_ENABLED=false
# General stateful ReAct executor; choose this OR guided build, never both.
# Same DB/JWKS/provider/key/mapping prerequisites. Legacy /chat stays unchanged.
AI_STATEFUL_REACT_ENABLED=false
AI_STATEFUL_REACT_VERSION=v1
# AI_HARDWARE_CATALOG_MAPPING={"version":"catalog-hardware-v1","categories":{"<actual-category-uuid>":"CPU"},"spec_fields":{},"option_fields":{}}
# Set to the identity-service's reachable JWKS endpoint before enabling.
# AI_JWT_JWKS_URL=http://localhost:8081/.well-known/jwks.json
AI_JWT_ISSUER=http://identity-service
AI_JWT_AUDIENCE=pc-shopping-api
# Retrieval defaults to the backend keyword API. Set retrieval to `hybrid` or
# `qdrant` only after the collection and embedding endpoint are provisioned.
AI_RETRIEVAL_BACKEND=backend
AI_QDRANT_URL=http://localhost:6333
AI_QDRANT_COLLECTION=products
AI_EMBEDDING_PROVIDER=http
# AI_EMBEDDING_API_URL=
# AI_EMBEDDING_API_KEY=
AI_EMBEDDING_DIMENSION=384
# Keep fallback for local development. Set `openai` or `gemini` only after
# the provider/model contract and secret injection are approved.
AI_PROVIDER=fallback
# AI_MODEL_NAME=
# AI_OPENAI_MODEL_NAME=gpt-4o-mini
# AI_GEMINI_MODEL_NAME=gemini-2.5-flash
# AI_OPENAI_API_KEY=
# AI_GEMINI_API_KEY=
# Select AI_PROVIDER explicitly; AI_MODEL_NAME is a bare model ID, not provider:model.
# AI_PROVIDER=fallback never invokes a model, even when AI_MODEL_NAME is set.
